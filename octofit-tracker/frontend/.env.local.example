# OctoFit Tracker Frontend - Environment Configuration

# REQUIRED: Codespaces environment name
# This variable must be set for the application to work properly in Codespaces
# 
# In GitHub Codespaces:
#   - This is automatically set by GitHub via `$CODESPACE_NAME` 
#   - The frontend uses it to construct the API URL:
#     https://${CODESPACE_NAME}-8000.app.github.dev
#
# For local development:
#   - Leave this blank or unset to use http://localhost:8000
#   - This will automatically fallback to localhost
#
# To set this manually in .env.local:
VITE_CODESPACE_NAME=your-codespace-name

# Note: Vite environment variables must be prefixed with VITE_
# They are exposed to the client-side JavaScript via import.meta.env
#
# Example in code:
#   const codespaceName = import.meta.env.VITE_CODESPACE_NAME
#   const apiUrl = codespaceName 
#     ? `https://${codespaceName}-8000.app.github.dev`
#     : 'http://localhost:8000'
